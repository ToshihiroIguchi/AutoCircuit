{
  "name": "autocircuit-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Static-site front end for AutoCircuit; runs the Python core in the browser through Pyodide.",
  "scripts": {
    "assets": "node scripts/build-assets.mjs",
    "dev": "npm run assets && vite",
    "build": "npm run assets && npm run check && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && npm run schematic && npm run samples-check",
    "schematic": "node scripts/schematic-check.mjs",
    "samples-check": "node scripts/samples-check.mjs",
    "smoke": "npm run assets && node scripts/smoke.mjs"
  },
  "dependencies": {
    "plotly.js-basic-dist-min": "^3.1.0",
    "pyodide": "^314.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/plotly.js": "^3.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
