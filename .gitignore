__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
node_modules/
# Build artifact and run output of benchmarks/pyodide; the results live in its README.
benchmarks/pyodide/src.zip
benchmarks/pyodide/*.json
!benchmarks/pyodide/package.json
!benchmarks/pyodide/package-lock.json
benchmarks/pyodide/*.txt
# Generated by web/scripts/build-assets.mjs: the Pyodide distribution, the source archive, and
# the example sample datasets. Files that npm, make_zip.py and the project's own `simulate` CLI
# reproduce, so they are built rather than committed.
web/public/pyodide/
web/public/autocircuit-src.zip
web/public/samples/
# Bytecode compiled by web/scripts/precompile.mjs, and the record of what it was compiled from.
# Only valid for the exact interpreter Pyodide ships, which is why it is built and not committed.
# One overlay per load stage; the un-suffixed name is the single overlay they replaced, kept here
# so a tree that predates the split does not start offering it to be committed.
web/public/pyodide-bytecode.zip
web/public/pyodide-bytecode-numpy.zip
web/public/pyodide-bytecode-scipy.zip
web/public/.bytecode-stamp
web/.build/
web/dist/
# Scratch output of the browser automation used to check the web UI by hand.
.playwright-mcp/

# Frozen fitness landscapes for benchmarks/screening_round: 3.4 MB of screening costs that
# `landscape.py` rebuilds from the reference in about an hour, and the results live in
# docs/SEARCH_ALGORITHM_SCREENING.md. The small targets_*.json files ARE committed -- they are
# expensive (the CPE one is ~50 min of full-budget refits) and they define what counts as the
# truth for every later run.
benchmarks/screening_round/land_*.json
benchmarks/screening_round/sample_*.json
benchmarks/screening_round/*.jsonl
benchmarks/autoeis_round/arena_c/
benchmarks/autoeis_round/*.log
benchmarks/autoeis_round/*.log.err
