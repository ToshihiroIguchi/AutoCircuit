# Generated by web/scripts/build-assets.mjs: the Pyodide distribution, the source archive, and
# the example sample datasets. Files that npm, make_zip.py and the project's own `simulate` CLI
# reproduce, so they are built rather than committed.
web/public/pyodide/
web/public/autocircuit-src.zip
web/public/samples/
# Bytecode compiled by web/scripts/precompile.mjs, and the record of what it was compiled from.
# Only valid for the exact interpreter Pyodide ships, which is why it is built and not committed.
web/public/pyodide-bytecode.zip
web/public/.bytecode-stamp
web/.build/
web/dist/
